# Copy this file to .env and set your values.
# .env is gitignored — never commit it.

# API key for POST /predict and POST /reload
# Leave empty to disable authentication (local dev only)
API_KEY=change-me-to-a-random-secret

# PostgreSQL password for MLflow metadata backend
# Used by: postgres service + mlflow connection URI
POSTGRES_PASSWORD=change-me-to-a-random-secret

# Keycloak OAuth2 secrets (browser SSO for MLflow UI)
# OAUTH2_CLIENT_SECRET: client secret from Keycloak → Clients → mlops-client → Credentials
# OAUTH2_COOKIE_SECRET: random 32+ char string, e.g.: openssl rand -base64 32
OAUTH2_CLIENT_SECRET=change-me-keycloak-client-secret
OAUTH2_COOKIE_SECRET=change-me-32-chars-minimum-random-string!!

# Grafana admin password (access at https://localhost/grafana/)
GRAFANA_ADMIN_PASSWORD=change-me-to-a-random-secret
